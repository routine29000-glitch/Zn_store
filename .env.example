# ============================================================
#  ZN STORE — متغيرات البيئة
#  انسخ هذا الملف وسمّه .env.local للتطوير المحلي
#  على Vercel: أضف هذه المتغيرات في Settings > Environment Variables
# ============================================================

# ─── Upstash Redis (مطلوب) ────────────────────────────────────
# احصل عليها من: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://YOUR_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# ─── كلمة مرور الأدمن (مطلوب) ────────────────────────────────
ADMIN_PASSWORD=YourStrongPassword@2024

# ─── Backblaze B2 لرفع الصور (اختياري — يمكن استخدام Vercel Blob بدله) ─
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET=zn-store-products
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/zn-store-products

# ─── Vercel Blob (اختياري — بديل لـ B2) ──────────────────────
# يُضاف تلقائياً عند ربط Vercel Blob من لوحة التحكم
BLOB_READ_WRITE_TOKEN=vercel_blob_your_token

# ─── تيليجرام (اختياري) ──────────────────────────────────────
ADMIN_BOT_TOKEN=bot_token_for_admin_notifications
USER_BOT_TOKEN=bot_token_for_user_notifications
ADMIN_CHAT_ID=your_telegram_chat_id

# ─── سر تهيئة البيانات (لنقل البيانات الأولية) ──────────────
INIT_SECRET=zn_init_2024
